<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mathdle 六人對戰版</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121213;
            color: white;
            text-align: center;
            margin: 0;
            padding: 20px;
        }
        h1 { margin-bottom: 5px; }
        
        /* 六人狀態看板 */
        .players-dashboard {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            max-width: 800px;
            margin: 20px auto;
        }
        .player-card {
            background-color: #1a1a1c;
            border: 2px solid #3a3a3c;
            border-radius: 8px;
            padding: 10px;
        }
        .player-card.active { border-color: #538d4e; }
        
        /* 當前玩家的答題區 */
        .game-container {
            max-width: 500px;
            margin: 30px auto;
        }
        .grid {
            display: grid;
            grid-template-rows: repeat(6, 1fr);
            gap: 5px;
            margin-bottom: 20px;
        }
        .row {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 5px;
        }
        .tile {
            aspect-ratio: 1;
            border: 2px solid #3a3a3c;
            font-size: 1.5rem;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            text-transform: uppercase;
        }
        /* 顏色反饋樣式 */
        .correct { background-color: #538d4e; border-color: #538d4e; } /* 綠色：位置與數字皆對 */
        .present { background-color: #b59f3b; border-color: #b59f3b; } /* 黃/橘色：有此符號但位置錯 */
        .absent { background-color: #3a3a3c; border-color: #3a3a3c; }  /* 灰色：不包含此符號 */
    </style>
</head>
<body>

    <h1>Mathdle Multiplayer</h1>
    <p>目標：在 6 次猜測內找出正確的數學等式！</p>

    <!-- 1. 六人狀態即時面板 -->
    <div class="players-dashboard">
        <div class="player-card active" id="p1">玩家 1 (你)：第 1/6 次嘗試</div>
        <div class="player-card" id="p2">玩家 2：等候中...</div>
        <div class="player-card" id="p3">玩家 3：等候中...</div>
        <div class="player-card" id="p4">玩家 4：等候中...</div>
        <div class="player-card" id="p5">玩家 5：等候中...</div>
        <div class="player-card" id="p6">玩家 6：等候中...</div>
    </div>

    <!-- 2. 本地玩家答題網格 (以常見的 8 格等式為例，如 3+5=08 或 12+13=25) -->
    <div class="game-container">
        <div class="grid" id="gameGrid">
            <!-- 動態生成 6 行 × 8 格 -->
        </div>
    </div>

    <script>
        // 初始化 6x8 遊戲網格
        const grid = document.getElementById('gameGrid');
        const TARGET_EQUATION = "12+23=35"; // 示範答案
        
        for (let i = 0; i < 6; i++) {
            const row = document.createElement('div');
            row.className = 'row';
            for (let j = 0; j < 8; j++) {
                const tile = document.createElement('div');
                tile.className = 'tile';
                // 測試資料展示用
                if(i === 0) {
                    const testGuess = "10+20=30";
                    tile.innerText = testGuess[j];
                    // 簡易顏色比對邏輯
                    if(testGuess[j] === TARGET_EQUATION[j]) tile.classList.add('correct');
                    else if(TARGET_EQUATION.includes(testGuess[j])) tile.classList.add('present');
                    else tile.classList.add('absent');
                }
                row.appendChild(tile);
            }
            grid.appendChild(row);
        }

        // TODO: 在此處加入鍵盤監聽事件與數學邏輯驗證 (如 eval() 驗證等式左右相等)
    </script>
</body>
</html>
